    "def short_label(full_name, nickname=None):\n",
    "    \"\"\"Create a readable short label for a player.\"\"\"\n",
    "    if nickname and str(nickname).strip():\n",
    "        return str(nickname).strip()\n",
    "    parts = str(full_name).strip().split()\n",
    "    if len(parts) <= 2:\n",
    "        return \" \".join(parts)\n",
    "    tail = \" \".join(parts[-2:])\n",
    "    if len(tail) <= 18:\n",
    "        return tail\n",
    "    return parts[-1]\n",
    "\n",
