    "        allowed_pass_types=OPEN_PLAYISH_TYPES,\n",
    "    )\n",
    "    attempted_passes = slice_passes(\n",
    "        events_df,\n",
    "        team_name=team_name,\n",
    "        periods=[1],\n",
    "        completed_only=False,\n",
    "        starters_only=True,\n",
    "        allowed_pass_types=OPEN_PLAYISH_TYPES,\n",
    "    )\n",
    "\n",
    "    completed_graph, _, _ = build_player_graph(completed_passes, team_name, fixed_nodes=starter_pool)\n",
    "    attempted_graph, _, _ = build_player_graph(attempted_passes, team_name, fixed_nodes=starter_pool)\n",
    "\n",
    "    attempt_completed_graphs[(team_name, \"completed\")] = completed_graph\n",
    "    attempt_completed_graphs[(team_name, \"attempted\")] = attempted_graph\n",
    "\n",
    "    attempt_completed_rows.append(\n",
    "        {\n",
    "            \"team\": team_name,\n",
    "            \"version\": \"completed\",\n",
    "            \"pass_rows\": len(completed_passes),\n",
