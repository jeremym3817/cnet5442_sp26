    "def build_score_state_intervals(goal_events, end_minute):\n",
    "    \"\"\"Build score-state intervals from a goal timeline.\"\"\"\n",
    "    intervals = []\n",
    "    current_start = 0.0\n",
    "    argentina_goals = 0\n",
    "    france_goals = 0\n",
    "\n",
    "    for row in goal_events.sort_values(\"event_minute\").itertuples(index=False):\n",
    "        if argentina_goals == france_goals:\n",
    "            state = \"level\"\n",
    "        elif argentina_goals > france_goals:\n",
    "            state = \"Argentina leading\"\n",
    "        else:\n",
    "            state = \"France leading\"\n",
    "\n",
    "        intervals.append(\n",
    "            {\n",
    "                \"start\": current_start,\n",
    "                \"end\": float(row.event_minute),\n",
    "                \"score_before\": f\"Argentina {argentina_goals}-{france_goals} France\",\n",
    "                \"state\": state,\n",
    "            }\n",
    "        )\n",
    "\n",
    "        if row[0] == \"Argentina\":\n",
    "            argentina_goals += 1\n",
    "        else:\n",
    "            france_goals += 1\n",
    "        current_start = float(row.event_minute)\n",
    "\n",
    "    if argentina_goals == france_goals:\n",
    "        final_state = \"level\"\n",
    "    elif argentina_goals > france_goals:\n",
    "        final_state = \"Argentina leading\"\n",
    "    else:\n",
    "        final_state = \"France leading\"\n",
    "\n",
    "    intervals.append(\n",
    "        {\n",
    "            \"start\": current_start,\n",
    "            \"end\": float(end_minute),\n",
    "            \"score_before\": f\"Argentina {argentina_goals}-{france_goals} France\",\n",
    "            \"state\": final_state,\n",
    "        }\n",
    "    )\n",
    "\n",
    "    return pd.DataFrame(intervals)"
   ]
  },
