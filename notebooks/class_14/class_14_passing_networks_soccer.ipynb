    "        if team_name == \"Argentina\":\n",
    "            team_view = \"leading\" if interval.state == \"Argentina leading\" else (\"trailing\" if interval.state == \"France leading\" else \"level\")\n",
    "        else:\n",
    "            team_view = \"leading\" if interval.state == \"France leading\" else (\"trailing\" if interval.state == \"Argentina leading\" else \"level\")\n",
    "\n",
    "        interval_passes = slice_passes(\n",
    "            events_df,\n",
    "            team_name=team_name,\n",
    "            periods=[1, 2, 3, 4],\n",
    "            completed_only=True,\n",
    "            starters_only=False,\n",
    "            allowed_pass_types=OPEN_PLAYISH_TYPES,\n",
    "            minute_range=(interval.start, interval.end),\n",
    "        )\n",
    "        team_state_chunks.append((team_view, interval.end - interval.start, interval_passes))\n",
    "\n",
    "    for state in [\"leading\", \"level\", \"trailing\"]:\n",
    "        chunks = [chunk for chunk in team_state_chunks if chunk[0] == state]\n",
    "        if not chunks:\n",
    "            continue\n",
    "\n",
    "        state_minutes = sum(chunk[1] for chunk in chunks)\n",
    "        state_passes = pd.concat([chunk[2] for chunk in chunks], ignore_index=True)\n",
    "        state_graph, _, _ = build_player_graph(state_passes, team_name)\n",
    "\n",
    "        score_rows.append(\n",
    "            {\n",
    "                \"team\": team_name,\n",
    "                \"score_state_team_view\": state,\n",
    "                \"minutes\": state_minutes,\n",
    "                \"pass_rows\": len(state_passes),\n",
    "                \"passes_per_minute\": len(state_passes) / state_minutes,\n",
    "                **graph_summary(state_graph),\n",
    "            }\n",
    "        )\n",
    "\n",
    "score_state_summary = pd.DataFrame(score_rows)\n",
    "display(score_state_summary)"
   ]
