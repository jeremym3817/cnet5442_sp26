    "def extract_xy(value):\n",
    "    \"\"\"Return the first two coordinates from a StatsBomb location list.\"\"\"\n",
    "    if isinstance(value, (list, tuple)) and len(value) >= 2:\n",
    "        return float(value[0]), float(value[1])\n",
    "    return np.nan, np.nan\n",
    "\n",
    "def draw_statsbomb_pitch(ax, line_color=NEUTRAL, lw=1.2):\n",
    "    \"\"\"Draw a simple 120 x 80 StatsBomb pitch.\"\"\"\n",
    "    ax.add_patch(Rectangle((0, 0), 120, 80, fill=False, ec=line_color, lw=lw))\n",
    "    ax.plot([60, 60], [0, 80], color=line_color, lw=lw)\n",
    "    ax.add_patch(Circle((60, 40), 10, fill=False, ec=line_color, lw=lw))\n",
    "    ax.add_patch(Circle((60, 40), 0.6, color=line_color))\n",
    "\n",
    "    ax.add_patch(Rectangle((0, 18), 18, 44, fill=False, ec=line_color, lw=lw))\n",
    "    ax.add_patch(Rectangle((102, 18), 18, 44, fill=False, ec=line_color, lw=lw))\n",
    "    ax.add_patch(Rectangle((0, 30), 6, 20, fill=False, ec=line_color, lw=lw))\n",
    "    ax.add_patch(Rectangle((114, 30), 6, 20, fill=False, ec=line_color, lw=lw))\n",
    "\n",
    "    ax.add_patch(Circle((12, 40), 0.6, color=line_color))\n",
    "    ax.add_patch(Circle((108, 40), 0.6, color=line_color))\n",
    "    ax.add_patch(Arc((12, 40), 20, 20, angle=0, theta1=310, theta2=50, ec=line_color, lw=lw))\n",
    "    ax.add_patch(Arc((108, 40), 20, 20, angle=0, theta1=130, theta2=230, ec=line_color, lw=lw))\n",
    "\n",
    "    ax.add_patch(Arc((0, 0), 2, 2, angle=0, theta1=0, theta2=90, ec=line_color, lw=lw))\n",
