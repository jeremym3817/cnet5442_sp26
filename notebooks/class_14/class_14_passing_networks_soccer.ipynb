    "import matplotlib as mpl\n",
    "from mpl_toolkits.axes_grid1.inset_locator import inset_axes\n",
    "\n",
    "def value_to_unit_interval(values):\n",
    "    \"\"\"Map numeric values to [0, 1] for color normalization.\"\"\"\n",
    "    values = np.asarray(values, dtype=float)\n",
    "    if len(values) == 0:\n",
    "        return np.array([])\n",
    "    vmin, vmax = float(values.min()), float(values.max())\n",
    "    if np.isclose(vmin, vmax):\n",
    "        return np.full(len(values), 0.5)\n",
    "    return (values - vmin) / (vmax - vmin)\n",
    "\n",
    "def perceived_luminance(rgba):\n",
    "    \"\"\"Approximate luminance of an RGBA color for readable text.\"\"\"\n",
    "    r, g, b = rgba[:3]\n",
    "    return 0.2126 * r + 0.7152 * g + 0.0722 * b\n",
    "\n",
    "def plot_metric_network_cmap(\n",
    "    graph,\n",
    "    metric_table,\n",
    "    metric_col,\n",
    "    ax,\n",
    "    cmap_name,\n",
    "    title,\n",
    "    node_size=900,\n",
    "    add_colorbar=True,\n",
    "):\n",
    "    \"\"\"Plot the same passing network while coloring nodes by one metric column.\"\"\"\n",
    "    draw_statsbomb_pitch(ax)\n",
    "\n",
    "    # Draw weighted edges\n",
    "    edges = list(graph.edges(data=True))\n",
    "    if edges:\n",
    "        edge_weights = np.array([data[\"weight\"] for _, _, data in edges], dtype=float)\n",
    "        edge_widths = scale_to_range(edge_weights, 0.7, 4.8)\n",
    "\n",
    "        for (u, v, data), width in zip(edges, edge_widths):\n",
    "            x0, y0 = graph.nodes[u][\"x\"], graph.nodes[u][\"y\"]\n",
    "            x1, y1 = graph.nodes[v][\"x\"], graph.nodes[v][\"y\"]\n",
    "            ax.plot(\n",
    "                [x0, x1],\n",
    "                [y0, y1],\n",
    "                color=LIGHT_EDGE,\n",
    "                lw=width,\n",
    "                alpha=0.45,\n",
    "                solid_capstyle=\"round\",\n",
    "                zorder=1,\n",
    "            )\n",
    "\n",
    "    # Metric values\n",
    "    metric_lookup = metric_table.set_index(\"player\")[metric_col].to_dict()\n",
    "    nodes = list(graph.nodes())\n",
    "    values = np.array([metric_lookup.get(node, 0.0) for node in nodes], dtype=float)\n",
    "\n",
    "#     cmap = mpl.cm.get_cmap(cmap_name)\n",
    "    cmap = mpl.colormaps[cmap_name]\n",
    "\n",
    "    if np.allclose(values, values[0]):\n",
    "        norm = mpl.colors.Normalize(vmin=values[0] - 1, vmax=values[0] + 1)\n",
    "        scaled = np.full(len(values), 0.5)\n",
    "    else:\n",
    "        norm = mpl.colors.Normalize(vmin=float(values.min()), vmax=float(values.max()))\n",
    "        scaled = value_to_unit_interval(values)\n",
    "\n",
    "    node_colors = [cmap(v) for v in scaled]\n",
    "\n",
    "    # Draw nodes\n",
    "    for node, fill_color in zip(nodes, node_colors):\n",
    "        x, y = graph.nodes[node][\"x\"], graph.nodes[node][\"y\"]\n",
    "\n",
    "        ax.scatter(\n",
    "            x,\n",
    "            y,\n",
    "            s=node_size,\n",
    "            color=fill_color,\n",
    "            edgecolor=\".1\",\n",
    "            linewidth=1.4,\n",
    "            alpha=0.98,\n",
    "            zorder=2,\n",
    "        )\n",
    "\n",
    "        lum = perceived_luminance(fill_color)\n",
    "        text_color = \"black\" if lum > 0.6 else \"white\"\n",
    "        stroke_color = \"white\" if text_color == \"black\" else \"black\"\n",
    "\n",
    "        ax.text(\n",
    "            x,\n",
    "            y,\n",
    "            graph.nodes[node][\"label\"],\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "            fontsize=8.0,\n",
    "            color=text_color,\n",
    "            weight=\"bold\",\n",
    "            zorder=3,\n",
    "            path_effects=[patheffects.withStroke(linewidth=2.0, foreground=stroke_color)],\n",
    "        )\n",
    "\n",
    "    ax.set_title(title, fontsize='large', pad=0)\n",
    "\n",
    "    if add_colorbar:\n",
    "        sm = mpl.cm.ScalarMappable(norm=norm, cmap=cmap)\n",
    "        sm.set_array([])\n",
    "\n",
    "        cax = inset_axes(\n",
    "            ax,\n",
    "            width=\"4%\",\n",
    "            height=\"32%\",\n",
    "            loc=\"lower left\",\n",
    "            bbox_to_anchor=(0.03, 0.05, 1, 1),\n",
    "            bbox_transform=ax.transAxes,\n",
    "            borderpad=0,\n",
    "        )\n",
    "        cb = plt.colorbar(sm, cax=cax)\n",
    "        cb.ax.tick_params(labelsize=7, length=2)\n",
    "        cb.outline.set_linewidth(0.6)\n",
    "\n",
    "metric_panels = [\n",
    "    (\"out_strength\", \"out-strength\", \"Blues\"),\n",
    "    (\"in_strength\", \"in-strength\", \"Greens\"),\n",
    "    (\"out_degree_centrality\", \"out-degree centrality\", \"Oranges\"),\n",
    "    (\"in_degree_centrality\", \"in-degree centrality\", \"Purples\"),\n",
    "    (\"betweenness\", \"betweenness\", \"Reds\"),\n",
    "    (\"harmonic\", \"harmonic centrality\", \"viridis\"),\n",
    "    (\"pagerank\", \"PageRank\", \"YlGnBu\"),\n",
    "    (\"hub_score\", \"hub score\", \"PuRd\"),\n",
    "    (\"authority_score\", \"authority score\", \"cividis\"),\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(3, 3, figsize=(19, 14), dpi=200)\n",
    "\n",
    "\n",
    "for ax, (metric_col, title, cmap_name) in zip(axes.ravel(), metric_panels):\n",
    "    plot_metric_network_cmap(\n",
    "        argentina_1h_graph,\n",
    "        argentina_node_metrics,\n",
    "        metric_col=metric_col,\n",
    "        ax=ax,\n",
    "        cmap_name=cmap_name,\n",
    "        title=title,\n",
    "        node_size=900,\n",
    "        add_colorbar=True,\n",
    "    )\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Argentina first half: the same passing network viewed through nine node-level properties\",\n",
    "    y=0.995,\n",
    "    fontsize=16,\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig('images/passing_networks_argentina_centralities.png',dpi=425, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
