    "def scale_to_range(values, low, high):\n",
    "    \"\"\"Linearly rescale an array to a numeric range.\"\"\"\n",
    "    values = np.asarray(values, dtype=float)\n",
    "    if len(values) == 0:\n",
    "        return np.array([])\n",
    "    vmin, vmax = float(values.min()), float(values.max())\n",
    "    if np.isclose(vmin, vmax):\n",
    "        return np.full_like(values, (low + high) / 2.0, dtype=float)\n",
    "    return low + (values - vmin) * (high - low) / (vmax - vmin)\n",
    "\n",
    "def plot_metric_network(graph, metric_table, metric_col, ax, node_color, title):\n",
    "    \"\"\"Plot the same passing network while sizing nodes by one metric column.\"\"\"\n",
    "    draw_statsbomb_pitch(ax)\n",
    "\n",
    "    edges = list(graph.edges(data=True))\n",
    "    if edges:\n",
    "        widths = scale_to_range([data[\"weight\"] for _, _, data in edges], 0.7, 4.8)\n",
    "        for (u, v, data), width in zip(edges, widths):\n",
    "            x0, y0 = graph.nodes[u][\"x\"], graph.nodes[u][\"y\"]\n",
    "            x1, y1 = graph.nodes[v][\"x\"], graph.nodes[v][\"y\"]\n",
    "            ax.plot([x0, x1], [y0, y1], color=LIGHT_EDGE, lw=width, alpha=0.45, solid_capstyle=\"round\", zorder=1)\n",
    "\n",
    "    metric_lookup = metric_table.set_index(\"player\")[metric_col].to_dict()\n",
    "    values = np.array([metric_lookup.get(node, 0.0) for node in graph.nodes()], dtype=float)\n",
    "    sizes = scale_to_range(values, 250, 1750)\n",
    "\n",
    "    for node, size in zip(graph.nodes(), sizes):\n",
    "        x, y = graph.nodes[node][\"x\"], graph.nodes[node][\"y\"]\n",
    "        ax.scatter(x, y, s=size, color=node_color, edgecolor=\"white\", linewidth=1.3, alpha=0.96, zorder=2)\n",
    "        ax.text(\n",
    "            x,\n",
    "            y,\n",
    "            graph.nodes[node][\"label\"],\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "            fontsize=8.0,\n",
    "            color=\"white\",\n",
    "            weight=\"bold\",\n",
    "            zorder=3,\n",
    "            path_effects=[patheffects.withStroke(linewidth=2.0, foreground=node_color)],\n",
    "        )\n",
    "\n",
    "    ax.set_title(title, fontsize=11, pad=10)"
   ]
