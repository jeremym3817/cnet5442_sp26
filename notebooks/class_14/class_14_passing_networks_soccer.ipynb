    "def slice_passes(\n",
    "    events_table,\n",
    "    team_name,\n",
    "    periods,\n",
    "    completed_only=True,\n",
    "    starters_only=False,\n",
    "    allowed_pass_types=None,\n",
    "    minute_range=None,\n",
    "    recipient_known=True,\n",
    "    fixed_player_pool=None,\n",
    "):\n",
    "    \"\"\"Return a cleaned pass table with explicit columns and optional filters.\"\"\"\n",
    "    subset = events_table.loc[events_table[\"type.name\"] == \"Pass\"].copy()\n",
    "    subset = subset.loc[subset[\"team.name\"] == team_name].copy()\n",
    "    subset = subset.loc[subset[\"period\"].isin(periods)].copy()\n",
    "\n",
    "    if minute_range is not None:\n",
    "        start_minute, end_minute = minute_range\n",
    "        subset = subset.loc[\n",
    "            (subset[\"event_minute\"] >= start_minute)\n",
    "            & (subset[\"event_minute\"] < end_minute)\n",
    "        ].copy()\n",
    "\n",
    "    subset[\"passer\"] = subset[\"player.name\"]\n",
    "    subset[\"recipient\"] = subset[\"pass.recipient.name\"]\n",
    "    subset[\"completed\"] = subset[\"pass.outcome.name\"].isna()\n",
    "    subset[\"pass_type_simple\"] = subset[\"pass.type.name\"].fillna(\"Regular\")\n",
    "\n",
    "    if allowed_pass_types is not None:\n",
    "        subset = subset.loc[subset[\"pass_type_simple\"].isin(allowed_pass_types)].copy()\n",
    "\n",
    "    if completed_only:\n",
    "        subset = subset.loc[subset[\"completed\"]].copy()\n",
    "\n",
    "    if recipient_known:\n",
    "        subset = subset.loc[subset[\"recipient\"].notna()].copy()\n",
    "\n",
    "    if starters_only:\n",
    "        starter_pool = set(get_starters(lineups_raw, team_name))\n",
    "        subset = subset.loc[\n",
    "            subset[\"passer\"].isin(starter_pool) & subset[\"recipient\"].isin(starter_pool)\n",
    "        ].copy()\n",
    "\n",
    "    if fixed_player_pool is not None:\n",
    "        fixed_player_pool = set(fixed_player_pool)\n",
    "        subset = subset.loc[\n",
    "            subset[\"passer\"].isin(fixed_player_pool) & subset[\"recipient\"].isin(fixed_player_pool)\n",
    "        ].copy()\n",
    "\n",
    "    subset = subset.loc[subset[\"passer\"] != subset[\"recipient\"]].copy()\n",
    "    return subset\n",
    "\n",
    "def average_on_ball_locations(pass_table):\n",
    "    \"\"\"Average pass origins and successful reception locations into one player location.\"\"\"\n",
    "    starts = pass_table.loc[:, [\"passer\", \"x\", \"y\"]].rename(columns={\"passer\": \"player\"})\n",
    "    receipts = (\n",
    "        pass_table.loc[pass_table[\"completed\"], [\"recipient\", \"end_x\", \"end_y\"]]\n",
    "        .rename(columns={\"recipient\": \"player\", \"end_x\": \"x\", \"end_y\": \"y\"})\n",
    "    )\n",
    "    return (\n",
    "        pd.concat([starts, receipts], ignore_index=True)\n",
    "        .dropna(subset=[\"player\", \"x\", \"y\"])\n",
    "        .groupby(\"player\", as_index=False)[[\"x\", \"y\"]]\n",
    "        .mean()\n",
    "    )\n",
    "\n",
    "def build_player_graph(pass_table, team_name, fixed_nodes=None):\n",
    "    \"\"\"Build a weighted directed player graph from one row per pass.\"\"\"\n",
    "    edge_table = (\n",
    "        pass_table.groupby([\"passer\", \"recipient\"], as_index=False)\n",
    "        .size()\n",
    "        .rename(columns={\"size\": \"weight\"})\n",
    "        .sort_values([\"passer\", \"recipient\"])\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "    graph = nx.DiGraph()\n",
    "    label_map = get_label_map(lineups_raw, team_name)\n",
    "    position_table = average_on_ball_locations(pass_table)\n",
    "    position_lookup = position_table.set_index(\"player\")[[\"x\", \"y\"]].to_dict(\"index\")\n",
    "\n",
    "    node_list = fixed_nodes if fixed_nodes is not None else sorted(set(edge_table[\"passer\"]).union(edge_table[\"recipient\"]))\n",
    "    for node in node_list:\n",
    "        graph.add_node(\n",
    "            node,\n",
    "            label=label_map.get(node, node),\n",
    "            x=float(position_lookup.get(node, {\"x\": np.nan})[\"x\"]),\n",
    "            y=float(position_lookup.get(node, {\"y\": np.nan})[\"y\"]),\n",
    "        )\n",
    "\n",
    "    for row in edge_table.itertuples(index=False):\n",
    "        graph.add_edge(\n",
    "            row.passer,\n",
    "            row.recipient,\n",
    "            weight=int(row.weight),\n",
    "            distance=1.0 / float(row.weight),\n",
    "        )\n",
    "\n",
    "    total_strength = (\n",
    "        pd.Series(dict(graph.out_degree(weight=\"weight\")))\n",
    "        .add(pd.Series(dict(graph.in_degree(weight=\"weight\"))), fill_value=0)\n",
    "    )\n",
    "    for node in graph.nodes():\n",
    "        graph.nodes[node][\"total_strength\"] = float(total_strength.get(node, 0.0))\n",
    "\n",
    "    return graph, edge_table, position_table\n",
    "\n",
    "def compute_node_metric_table(graph):\n",
    "    \"\"\"Compute a compact node-level metric table for a directed weighted graph.\"\"\"\n",
    "    table = pd.DataFrame({\"player\": list(graph.nodes())})\n",
    "    table[\"label\"] = table[\"player\"].map({node: graph.nodes[node].get(\"label\", node) for node in graph.nodes()})\n",
    "    table[\"out_strength\"] = table[\"player\"].map(dict(graph.out_degree(weight=\"weight\")))\n",
    "    table[\"in_strength\"] = table[\"player\"].map(dict(graph.in_degree(weight=\"weight\")))\n",
    "    table[\"total_strength\"] = table[\"out_strength\"] + table[\"in_strength\"]\n",
    "    table[\"out_degree_centrality\"] = table[\"player\"].map(nx.out_degree_centrality(graph))\n",
    "    table[\"in_degree_centrality\"] = table[\"player\"].map(nx.in_degree_centrality(graph))\n",
    "    table[\"betweenness\"] = table[\"player\"].map(nx.betweenness_centrality(graph, weight=\"distance\", normalized=True))\n",
    "    table[\"harmonic\"] = table[\"player\"].map(nx.harmonic_centrality(graph, distance=\"distance\"))\n",
    "    table[\"pagerank\"] = table[\"player\"].map(nx.pagerank(graph, weight=\"weight\"))\n",
    "    hubs, authorities = nx.hits(graph, normalized=True)\n",
    "    table[\"hub_score\"] = table[\"player\"].map(hubs)\n",
    "    table[\"authority_score\"] = table[\"player\"].map(authorities)\n",
    "    return table\n",
    "\n",
    "def graph_summary(graph):\n",
    "    \"\"\"Return a small graph-level summary table row.\"\"\"\n",
    "    reciprocity = nx.reciprocity(graph)\n",
    "    return {\n",
    "        \"nodes\": graph.number_of_nodes(),\n",
    "        \"edges\": graph.number_of_edges(),\n",
    "        \"total_weight\": sum(data[\"weight\"] for _, _, data in graph.edges(data=True)),\n",
    "        \"density\": nx.density(graph),\n",
    "        \"reciprocity\": np.nan if reciprocity is None else reciprocity,\n",
    "    }\n",
    "\n",
    "def plot_team_network(graph, ax, node_color, title):\n",
    "    \"\"\"Plot a passing network with node size based on total strength.\"\"\"\n",
    "    metric_table = pd.DataFrame(\n",
    "        {\n",
    "            \"player\": list(graph.nodes()),\n",
    "            \"total_strength\": [graph.nodes[node].get(\"total_strength\", 0.0) for node in graph.nodes()],\n",
    "        }\n",
    "    )\n",
    "    plot_metric_network(graph, metric_table, metric_col=\"total_strength\", ax=ax, node_color=node_color, title=title)\n",
    "\n",
    "def plot_adjacency_heatmap(graph, order, ax, cmap):\n",
    "    \"\"\"Plot a weighted adjacency matrix using a chosen node order.\"\"\"\n",
    "    adjacency = nx.to_pandas_adjacency(graph, nodelist=order, weight=\"weight\", dtype=float)\n",
    "    image = ax.imshow(adjacency.values, cmap=cmap, aspect=\"auto\")\n",
    "    ax.set_xticks(range(len(order)))\n",
    "    ax.set_yticks(range(len(order)))\n",
    "    ax.set_xticklabels([graph.nodes[node][\"label\"] for node in order], rotation=90)\n",
    "    ax.set_yticklabels([graph.nodes[node][\"label\"] for node in order])\n",
    "    ax.set_xlabel(\"recipient\")\n",
    "    ax.set_ylabel(\"passer\")\n",
    "    return image\n",
    "\n",
    "def mutual_link_table(edge_table, label_map):\n",
    "    \"\"\"Return a table of reciprocal directed pairs.\"\"\"\n",
    "    lookup = {(row.passer, row.recipient): int(row.weight) for row in edge_table.itertuples(index=False)}\n",
    "    rows = []\n",
    "    seen = set()\n",
    "    for (u, v), w_uv in lookup.items():\n",
    "        if (v, u) in lookup and frozenset({u, v}) not in seen:\n",
    "            w_vu = lookup[(v, u)]\n",
    "            rows.append(\n",
    "                {\n",
    "                    \"pair\": f\"{label_map.get(u, u)} <-> {label_map.get(v, v)}\",\n",
    "                    \"u_to_v\": w_uv,\n",
    "                    \"v_to_u\": w_vu,\n",
    "                    \"two_way_total\": w_uv + w_vu,\n",
    "                }\n",
    "            )\n",
    "            seen.add(frozenset({u, v}))\n",
    "    return pd.DataFrame(rows).sort_values(\"two_way_total\", ascending=False).reset_index(drop=True)\n"
   ]
  },
