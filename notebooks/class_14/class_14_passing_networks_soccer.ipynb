    "def get_team_entry(lineups, team_name):\n",
    "    \"\"\"Return the lineup dictionary for one team.\"\"\"\n",
    "    for entry in lineups:\n",
    "        if entry[\"team_name\"] == team_name:\n",
    "            return entry\n",
    "    raise ValueError(f\"Could not find lineup entry for {team_name!r}.\")\n",
    "\n",
    "def get_starters(lineups, team_name):\n",
    "    \"\"\"Return players whose first listed segment begins in the Starting XI.\"\"\"\n",
    "    starters = []\n",
    "    for player in get_team_entry(lineups, team_name)[\"lineup\"]:\n",
    "        positions = player.get(\"positions\", [])\n",
    "        if positions and positions[0].get(\"start_reason\") == \"Starting XI\":\n",
    "            starters.append(player[\"player_name\"])\n",
    "    return starters\n",
    "\n",
    "def get_label_map(lineups, team_name):\n",
    "    \"\"\"Map player names to short plot labels for one team.\"\"\"\n",
    "    entry = get_team_entry(lineups, team_name)\n",
    "    return {\n",
    "        player[\"player_name\"]: short_label(player[\"player_name\"], player.get(\"player_nickname\"))\n",
    "        for player in entry[\"lineup\"]\n",
    "    }"
   ]
  },
